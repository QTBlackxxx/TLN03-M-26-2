frr version 10.7.1
frr defaults traditional
hostname as100-borde1
log syslog informational
!
ip prefix-list PF-PRF-AS100 seq 5 permit 45.10.0.0/29
ip prefix-list PF-PRF-AS100-IN seq 5 permit 50.20.0.0/29
!
route-map PF-AS100-REGEXP-OUT permit 10
 match as-path AS-PATH-100-OUT
exit
!
route-map PRF-AS100 permit 10
 match ip address prefix-list PF-PRF-AS100
exit
!
route-map PRF-AS100-IN permit 10
 match ip address prefix-list PF-PRF-AS100-IN
exit
!
interface eth1
 ip address 161.0.0.1/30
exit
!
interface eth2
 ip address 161.0.1.1/30
exit
!
interface eth3
 ip address 10.0.0.62/30
 ip ospf network point-to-point
 ip ospf prefix-suppression
 ipv6 ospf6 area 0
 ipv6 ospf6 network point-to-point
exit
!
interface lo
 ip address 200.1.1.1/32
 ip ospf passive
 ipv6 address 2001:1:1::1/128
 ipv6 ospf6 area 0
 ipv6 ospf6 network point-to-point
exit
!
router bgp 100
 bgp router-id 200.1.1.1
 no bgp default ipv4-unicast
 neighbor 161.0.0.2 remote-as 200
 neighbor 172.16.3.1 remote-as 100
 neighbor 172.16.3.1 update-source lo
 neighbor 172.16.3.2 remote-as 100
 neighbor 172.16.3.2 update-source lo
 neighbor fc10:16:3::1 remote-as 100
 neighbor fc10:16:3::1 update-source lo
 neighbor fc10:16:3::2 remote-as 100
 neighbor fc10:16:3::2 update-source lo
 !
 address-family ipv4 unicast
  neighbor 161.0.0.2 activate
  neighbor 161.0.0.2 route-map PRF-AS100-IN in
  neighbor 161.0.0.2 route-map PF-AS100-REGEXP-OUT out
  neighbor 172.16.3.1 activate
  neighbor 172.16.3.2 activate
 exit-address-family
 !
 address-family ipv6 unicast
  neighbor fc10:16:3::1 activate
  neighbor fc10:16:3::2 activate
 exit-address-family
exit
!
router ospf
 network 10.0.0.60/30 area 0
 network 200.1.1.1/32 area 0
exit
!
router ospf6
exit
!
bgp as-path access-list AS-PATH-100-OUT seq 5 permit ^$
!
